# HE inner products of the 'hegc' pair version (hemi-party.x: BFV matrix triples, two parties).
# Party 0 = client p, party 1 = client q, m padded rows each (dummy rows: zeros).
#
#   ./compile.py -F 40 pair_inner m=4 d=384      (run with a ~61-bit NTT prime, PRIME_HE)
#
# Inputs, both parties, per row: e_1..e_d (round(e*2^7)), r (round(r*2^14)).
# Party 1 then: rho_e per entry e = i*m + j, uniform in [2^18, 2^58).
# Output to party 0 only, one line 'X [x_0, x_1, ...]' (one opening round), x_e = s_e + rho_e, s_e = 2<e_i,e'_j> - r_i - r'_j
# (an integer: no wrap-around in the field). x_e is statistically hidden (distance <= 2^-39);
# s_e is never opened. pair_gc.mpc (kw=masked) compares after reducing the shares mod 2^L.
# The image test runs in pair_gc.mpc (a popcount is cheaper there than an HE matrix product).

A = dict(a.split('=', 1) for a in program.args if '=' in a)
m, d = int(A['m']), int(A['d'])
n = m * m

# Only party 0's L and party 1's R enter the product; each party inputs all its rows at once (one
# input round): per row e_1..e_d, r.
v = [sint.get_input_from(p, size=m * (d + 1)) for p in range(2)]
Lm, Rm = sint.Matrix(m, d + 2), sint.Matrix(m, d + 2)         # Lm.Rm^T = 2<e,e'> - r - r'
for i in range(m):
    e0, r0 = v[0].get_vector(i * (d + 1), d), v[0][i * (d + 1) + d]
    e1, r1 = v[1].get_vector(i * (d + 1), d), v[1][i * (d + 1) + d]
    Lm[i].assign_vector(2 * e0)
    Rm[i].assign_vector(e1)
    Lm[i][d], Lm[i][d + 1] = -r0, sint(-1)
    Rm[i][d], Rm[i][d + 1] = sint(1), r1
L_, R_ = [Lm], [None, Rm]

x = L_[0].mul_trans(R_[1]).get_vector() + sint.get_input_from(1, size=n)
print_ln_to(0, 'X %s', x.reveal_to(0))
